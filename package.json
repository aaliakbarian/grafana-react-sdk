{
  "name": "grafana-react-sdk-poc-root",
  "version": "0.0.0-poc",
  "private": true,
  "description": "Disposable private research workspace for the Grafana native-rendering POC.",
  "packageManager": "yarn@4.17.1",
  "engines": {
    "node": "22.23.3"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "install:poc": "yarn install --immutable",
    "typecheck": "yarn workspace @grafana-react-sdk/poc-host typecheck && yarn workspace @grafana-react-sdk/poc-compat typecheck && yarn workspace @grafana-react-sdk/poc-grafana-bridge typecheck && tsc6 --project tests/e2e/tsconfig.json",
    "test:unit": "vitest run packages/poc-compat/src/toolchain.test.ts packages/poc-compat/src/fixtures/fixtureContract.test.ts packages/poc-compat/src/instrumentation/instrumentation.test.ts packages/poc-compat/src/config/importOrder.test.ts packages/poc-compat/src/network/backendSrvAdapter.test.ts packages/poc-compat/src/dashboard/dashboardClient.test.ts packages/poc-compat/src/dashboard/preflightFixture.test.ts packages/poc-compat/src/scenes/convertFixtureV1.test.ts packages/poc-compat/src/scenes/sceneLifecycle.test.ts packages/poc-compat/src/runtime/acquirePocRuntime.test.ts packages/poc-compat/src/datasource/loadFrontendSettings.test.ts packages/poc-compat/src/datasource/pocDataSourceSrv.test.ts packages/poc-compat/src/events/installLoggerRegistry.test.ts packages/poc-compat/src/events/installTemplateSrv.test.ts packages/poc-compat/src/query/runRequest.test.ts packages/poc-compat/src/registries/installGateBFieldConfig.test.ts packages/poc-grafana-bridge/src/panels/text.test.ts packages/poc-grafana-bridge/src/panels/stat.test.ts packages/poc-grafana-bridge/src/datasources/testdata.test.ts apps/poc-host/build/pinnedGrafanaSourceTransformPlugin.test.ts apps/poc-host/src/host.test.ts --environment node",
    "test:integration": "vitest run --dir integration --environment node --passWithNoTests",
    "test:e2e": "playwright test tests/e2e --pass-with-no-tests",
    "build:poc": "tsc6 -b tsconfig.base.json --pretty false && yarn workspace @grafana-react-sdk/poc-host build:app",
    "inspect:bundle": "yarn build:poc && node scripts/inspect-poc-bundle.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@playwright/test": "1.56.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.1",
    "playwright-core": "1.56.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  },
  "resolutions": {
    "@emotion/css": "11.13.5",
    "@emotion/react": "11.14.0",
    "@grafana/data": "13.2.3",
    "@grafana/e2e-selectors": "13.2.3",
    "@grafana/i18n": "13.2.3",
    "@grafana/runtime": "13.2.3",
    "@grafana/scenes": "8.13.5",
    "@grafana/schema": "13.2.3",
    "@grafana/ui": "13.2.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rxjs": "7.8.2",
    "uplot": "1.6.32"
  }
}
